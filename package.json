{
  "name": "luper",
  "private": true,
  "version": "1.0.0",
  "description": "Luper - Windows Operating System Optimization & Performance Application",
  "author": "Himmet Muhammed <himmetmuhammedk@gmail.com>",
  "type": "module",
  "main": "electron/main.js",
  "repository": "https://github.com/user/windows-optimizer",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron": "electron .",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\"",
    "lint": "tsc --noEmit",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.luper.app",
    "productName": "Luper Windows Optimizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "check-disk-space": "^3.4.0",
    "electron-updater": "^6.8.9",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^12.16.0",
    "motion": "^12.23.24",
    "pidusage": "^4.0.1",
    "pino": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.7",
    "systeminformation": "^5.33.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
