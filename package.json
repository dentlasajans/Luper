{
    "name":  "luper",
    "private":  true,
    "version":  "1.2.0",
    "description":  "Luper - Windows Operating System Optimization \u0026 Performance Application",
    "author":  "Himmet Muhammed \u003chimmetmuhammedk@gmail.com\u003e",
    "type":  "module",
    "main":  "dist-electron/main.cjs",
    "repository":  "https://github.com/dentlasajans/Luper",
    "scripts":  {
                    "dev":  "vite --port=3000 --host=0.0.0.0",
                    "build":  "vite build \u0026\u0026 npm run build:electron",
                    "build:electron":  "tsup",
                    "start":  "npm run build \u0026\u0026 node scripts/start.js",
                    "electron":  "node scripts/start.js",
                    "preview":  "vite preview",
                    "clean":  "node -e \"fs.rmSync(\u0027dist\u0027, {recursive: true, force: true})\"",
                    "lint":  "tsc --noEmit",
                    "test":  "jest",
                    "test:coverage":  "jest --coverage",
                    "dist":  "electron-builder",
                    "build-native":  "node-gyp rebuild --target=43.2.0 --arch=x64 --dist-url=https://electronjs.org/headers"
                },
    "build":  {
                  "appId":  "com.luper.app",
                  "productName":  "Luper Windows Optimizer",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*"
                            ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ],
                              "requestedExecutionLevel":  "requireAdministrator"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "deleteAppDataOnUninstall":  true,
                               "include":  "installer/custom.nsh"
                           },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "releaseType":  "release"
                                  }
                              ]
              },
    "dependencies":  {
                         "@dnd-kit/core":  "^6.3.1",
                         "@dnd-kit/sortable":  "^10.0.0",
                         "@dnd-kit/utilities":  "^3.2.2",
                         "@formkit/auto-animate":  "^0.10.0",
                         "chart.js":  "^4.5.1",
                         "check-disk-space":  "^3.4.0",
                         "electron-updater":  "^6.8.9",
                         "fast-deep-equal":  "^3.1.3",
                         "firebase":  "^12.16.0",
                         "fuse.js":  "^7.5.0",
                         "lucide-react":  "^1.27.0",
                         "motion":  "^12.43.0",
                         "node-addon-api":  "^8.9.0",
                         "pidusage":  "^4.0.1",
                         "pino":  "^10.3.1",
                         "react":  "^19.0.1",
                         "react-chartjs-2":  "^5.3.1",
                         "react-dom":  "^19.0.1",
                         "sonner":  "^2.0.7",
                         "systeminformation":  "^5.33.1",
                         "zod":  "^4.4.3",
                         "zustand":  "^5.0.14"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.1.14",
                            "@testing-library/dom":  "^10.4.0",
                            "@testing-library/jest-dom":  "^6.6.3",
                            "@testing-library/react":  "^16.2.0",
                            "@types/jest":  "^29.5.14",
                            "@types/node":  "^22.20.1",
                            "@types/pidusage":  "^2.0.5",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^5.0.4",
                            "electron":  "^43.2.0",
                            "electron-builder":  "^26.15.3",
                            "jest":  "^30.4.2",
                            "jest-environment-jsdom":  "^29.7.0",
                            "tailwindcss":  "^4.1.14",
                            "ts-jest":  "^29.1.2",
                            "ts-prune":  "^0.9.1",
                            "tsup":  "^8.5.1",
                            "tsx":  "^4.21.0",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.3"
                        }
}
